{{template "base" .}}

{{define "content"}}


<!--Carousel -->
<div id="main-carousel" class="carousel slide carousel-fade">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#main-carousel" data-bs-slide-to="0" class="active" aria-current="true"
                aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#main-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#main-carousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <!--    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">-->
    <!--        <img src="/static/images/room-images/generals-quarters.png"-->
    <!--             class="img-fluid img-thumbnail mx-auto d-block room-image"-->
    <!--             alt="room image">-->

    <div class="carousel-inner w-80 h-80 ">
        <div class="carousel-item">
            <img src="/static/images/tray.png" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>Allow yourself a break</h5>
                <p>The best food prepared with love and care.</p>
            </div>
        </div>
        <div class="carousel-item active">
            <img src="/static/images/woman-laptop.png" class="d-block" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>Work with the view</h5>
                <p>Our rooms are equipt with high-speed internet.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/static/images/outside.png" class="d-block w-100" alt="...">
            <div class="carousel-caption d-none d-md-block">
                <h5>Most stunning location</h5>
                <p>Take a walk in the surrounding. It has the best views.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#main-carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#main-carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!--Main content-->
<div class="container">
    <div class="row">
        <div class="col">
            <br>
            <h1 class="text-center">Welcome to Fort Smythe Bed and Breakfast</h1>
            <p class="text-center mt-4">Your home away from home.</p>
        </div>
    </div>

    <div class="row">
        <div class="col text-center">
            <p>
                Discover a cozy retreat in the heart of Canada at Forth Smythe Bed & Breakfast.
                With two uniquely charming rooms—the General’s Quarters and the Major’s Suite—our B&B offers comfort,
                warmth, and a peaceful escape from the everyday. Whether you’re here for a weekend getaway or a longer
                stay, Forth Smythe is your perfect home-away-from-home.<br>

                <strong>Book Your Stay Today</strong><br>
                Don’t wait to experience the charm and tranquility of Forth Smythe. Reserve your room now and start
                your Canadian escape with a touch of comfort and style.
            </p>
        </div>
    </div>

    <div>
        <div class="col text-center">
            <a href="/search-availability" class="btn btn-success">Make Reservation Now</a>
        </div>
    </div>
</div>


{{end}}