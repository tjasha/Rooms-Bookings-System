{{template "base" .}}

{{define "content"}}

<div class="container mt-2">
    <div class="row">
        <div class="col">
            <h1>Choose a room</h1>

            {{$rooms := index .Data "rooms"}}

            <ul>

            {{range $rooms}}
                <button>
                <li><a href="/choose-room/{{.ID}}">{{.RoomName}}<br></li>
                </button>
            {{end}}
            </ul>
        </div>
    </div>
</div>

{{end}}