{{template "admin" .}}

{{define "page-title"}}
Reservations calendar
{{end}}

{{define "content"}}
    {{$now := index .Data "now"}}
    {{$rooms := index .Data "rooms"}}
    {{$dim := index .IntMap "days_in_month"}}
    {{$curMonth := index .StringMap "this_month"}}
    {{$curYear := index .StringMap "this_year"}}

    <div class="col-md-12">

        <div class="text-center">
            <!-- representation of format data in golang-->
            <h3>{{formatDate $now "January"}} {{formatDate $now "2006"}} </h3>
        </div>

        <div class="float-start">
            <a class="btn btn-sm btn-outline-secondary"
               href="/admin/reservations-calendar?y={{index .StringMap "last_month_year"}}&m={{index .StringMap "last_month"}}">&lt;&lt;</a>
        </div>
        <!-- &lt stands for 'less then' and &gt stands for 'greater then"-->
        <div class="float-end">
            <a class="btn btn-sm btn-outline-secondary"
               href="/admin/reservations-calendar?y={{index .StringMap "next_month_year"}}&m={{index .StringMap "next_month"}}">&gt;&gt;</a>
        </div>
        <div class="clearfix"></div>

        <form method="post" action="/admin/reservations-calendar">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="m" value="{{index .StringMap "this_month"}}">
            <input type="hidden" name="y" value="{{index .StringMap "this_year"}}">

        {{range $rooms}}
            {{$roomID := .ID}}
            <!-- we want data for every day, but this data is outside of range. for this, we
             can use '$.Data'. To put this variable into the value, we can use
             printf function and %d for placeholder -->
            {{$blocks := index $.Data (printf "block_map_%d" .ID)}}
            {{$reservations := index $.Data (printf "reservation_map_%d" .ID)}}

            <h4 class="mt-4">{{.RoomName}}</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <tr class="table-light">
                        <!--we want to iterate through dates of the month-->
                        {{range $index := iterate $dim}}
                            <td class="text-center">
                                {{add $index 1}}
                            </td>
                        {{end}}
                    </tr>

                    <tr class="text-center">
                        {{range $index := iterate $dim}}
                        <td class="text-center">

                            {{if gt (index $reservations (printf "%s-%s-%d" $curYear $curMonth (add $index 1))) 0 }}
                                <a href="/admin/reservations/cal/{{index $reservations (printf "%s-%s-%d" $curYear $curMonth (add $index 1))}}">
                            <span class="text-danger">R</span>
                            </a>
                            {{else}}

                            <input
                                    {{if gt (index $blocks (printf "%s-%s-%d" $curYear $curMonth (add $index 1))) 0 }}
                                        checked
                                        name="remove_block_{{$roomID}}_{{printf "%s-%s-%d" $curYear $curMonth (add $index 1)}}"
                                        value="{{index $blocks (printf "%s-%s-%d" $curYear $curMonth (add $index 1))}}"
                            {{else}}
                                name="add_block_{{$roomID}}_{{printf "%s-%s-%d" $curYear $curMonth (add $index 1)}}"
                                value=1
                            {{end}}
                            type="checkbox">

                            {{end}}
                        </td>
                        {{end}}
                    </tr>

                </table>
            </div>


        {{end}}

            <br>
            <input type="submit" class="btn btn-primary" value="Save Changes">

        </form>
    </div>
{{end}}